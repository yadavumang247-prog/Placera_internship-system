# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (defaults to local MongoDB; auto-falls back to in-memory if unreachable)
MONGO_URI=mongodb://localhost:27017/smart_placement

# JWT Authentication
JWT_SECRET=smart_internship_placement_platform_jwt_secret_key_2026_super_secure
JWT_EXPIRES_IN=7d

# Client Web Application URL (CORS allowed origin)
CLIENT_URL=http://localhost:5173

# File Upload Configuration
UPLOAD_STORAGE=local
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5

# Email Service Configuration (mockable or SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=notifications@smartplacement.edu
EMAIL_PASSWORD=secret_mail_pass
EMAIL_FROM="SmartPlace Notifications" <notifications@smartplacement.edu>

# Isolated Code Execution Service (for Coding assessments)
CODE_EXECUTION_URL=http://localhost:5000/api/mock-runner
CODE_EXECUTION_API_KEY=mock_sandbox_key
