{
  "name": "smart-internship-and-placement-allocation-platform",
  "version": "1.0.0",
  "description": "Placera — Smart Internship & Placement Allocation Platform",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix client && npm install --prefix server --omit=dev --ignore-scripts",
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node server/utils/seed.js",
    "test": "node server/tests/algorithm.test.js",
    "build": "npm run build --prefix client"
  },
  "keywords": [
    "internship",
    "campus-placement",
    "recruitment",
    "algorithms",
    "matching",
    "ranking",
    "top-n-selection",
    "min-heap",
    "react",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Placera Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
