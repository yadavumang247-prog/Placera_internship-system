datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STUDENT
  COMPANY
}

enum Mode {
  REMOTE
  HYBRID
  ONSITE
}

enum AllocationStatus {
  ALLOCATED
  ACCEPTED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student      Student?
  company      Company?

  @@map("users")
}

model Student {
  id          String       @id @default(cuid())
  userId      String       @unique
  rollNumber  String       @unique
  branch      String
  year        Int          @default(3)
  cgpa        Float
  skills      String       // Stored as comma-separated or JSON string for cross-db compatibility
  resumeUrl   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences Preference[]
  allocations Allocation[]

  @@map("students")
}

model Company {
  id          String       @id @default(cuid())
  userId      String?      @unique
  name        String
  description String
  logoUrl     String?
  website     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  internships Internship[]

  @@map("companies")
}

model Internship {
  id                  String       @id @default(cuid())
  companyId           String
  title               String
  description         String
  location            String
  mode                Mode         @default(REMOTE)
  stipend             Int          @default(0)
  duration            String       @default("3 Months")
  minimumCGPA         Float        @default(6.0)
  requiredSkills      String       // Comma-separated or JSON string
  totalSeats          Int          @default(1)
  availableSeats      Int          @default(1)
  applicationDeadline DateTime
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  preferences         Preference[]
  allocations         Allocation[]

  @@map("internships")
}

model Preference {
  id           String     @id @default(cuid())
  studentId    String
  internshipId String
  rank         Int        // 1 to 5

  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([studentId, internshipId])
  @@unique([studentId, rank])
  @@map("preferences")
}

model Allocation {
  id              String           @id @default(cuid())
  studentId       String
  internshipId    String
  score           Float
  preferenceRank  Int
  skillMatchScore Float
  cgpaScore       Float
  status          AllocationStatus @default(ALLOCATED)
  allocatedAt     DateTime         @default(now())

  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship      Internship       @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@map("allocations")
}

model AlgorithmRun {
  id                 String   @id @default(cuid())
  totalStudents      Int
  totalInternships   Int
  totalEligiblePairs Int
  totalAllocated     Int
  totalUnallocated   Int
  executionTime      Float    // milliseconds
  algorithmName      String   @default("Multi-Criteria Constrained Greedy Optimization")
  createdAt          DateTime @default(now())

  @@map("algorithm_runs")
}
